rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cada partida vive en saves/{uid}. Solo el usuario dueño de ese uid
    // (autenticado con el mismo Google Auth que usa la app) puede leer o
    // escribir su propio documento. Nadie puede tocar el de otro.
    match /saves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // leaderboard/{uid} es la versión pública y mínima del progreso de cada
    // jugador (alias + puntajes), separada de saves/ a propósito: cualquier
    // usuario autenticado puede LEER toda la colección para armar el ranking
    // global, pero cada quien solo puede escribir su propio documento.
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Todo lo demás, denegado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
