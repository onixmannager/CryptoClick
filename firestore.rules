rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== saves/{uid} =====
    // Guardado autoritativo del progreso del jugador. El cliente escribe
    // {data: JSON.stringify(estado), updatedAt: serverTimestamp()}.
    // Firestore Rules NO puede parsear el JSON de 'data' campo a campo, así
    // que la validación de contenido real (saldo, nivel, mejoras) no se
    // puede hacer aquí de forma completa: eso requiere mover el guardado
    // autoritativo a una Cloud Function que recalcule el estado en servidor
    // en vez de aceptar el JSON íntegro que manda el cliente (recomendado).
    //
    // Mientras tanto, estas reglas SÍ cierran el hueco de "escribir lo que
    // sea, cuando sea": validan esquema/tipos, ponen un tamaño máximo
    // razonable a 'data' (evita inflar el documento con basura), exigen que
    // 'updatedAt' sea el timestamp real del servidor (no se puede falsificar
    // la fecha desde el cliente) y fuerzan el mismo throttle mínimo que ya
    // usa la app (CLOUD_MIN_INTERVAL = 20s) también del lado servidor, para
    // que llamar a window.forceSaveCloud() en bucle desde la consola no
    // sirva para machacar el documento en ráfaga.
    match /saves/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && isValidSaveDoc();

      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && isValidSaveDoc()
                    // Bajado de 15s a 1s a petición expresa: además del
                    // autoguardado del padre (CLOUD_MIN_INTERVAL = 20s) y de
                    // ruleta.html, ahora invasion-core.js también escribe
                    // aquí (ver syncClkToMainSave() en invasion/js/) justo
                    // después de un robo o de comprar un escudo, momento que
                    // puede caer dentro de los 15s siguientes a un
                    // autoguardado reciente del padre. 1s sigue impidiendo
                    // machacar el documento en ráfaga desde la consola
                    // (window.forceSaveCloud() en bucle), solo deja de
                    // bloquear escrituras legítimas y espaciadas por más de
                    // 1s entre sí.
                    && request.time > resource.data.updatedAt + duration.value(1, 's');

      allow delete: if false;

      function isValidSaveDoc() {
        let d = request.resource.data;
        return d.keys().hasOnly(['data', 'updatedAt'])
          && d.data is string
          && d.data.size() > 0
          && d.data.size() <= 20000
          && d.updatedAt == request.time;
      }
    }

    // ===== leaderboard/{uid} =====
    // Versión pública y mínima del progreso de cada jugador (alias + puntajes).
    // Cualquier usuario autenticado puede LEER toda la colección para armar
    // el ranking global; cada quien solo puede escribir su propio documento.
    //
    // A diferencia de saves/, aquí los campos SÍ están planos y tipados, así
    // que se puede validar esquema, tipos y rango en serio: esto es lo que
    // impide que alguien use window.__fb / setDoc directo desde la consola
    // para falsear su posición en el Top 100 sin jugar.
    match /leaderboard/{uid} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && isValidLeaderboardDoc()
                    // En un documento nuevo no hay progreso previo que
                    // validar por delta: solo se acota a un techo absoluto
                    // muy generoso, para que ni siquiera el primer publish
                    // pueda arrancar con un valor de "saldo infinito"
                    // instantáneo. No se acota 'lvl' aquí porque el juego no
                    // define un nivel máximo (incremental sin techo).
                    && request.resource.data.total <= 1000000000
                    && request.resource.data.weekly <= 1000000000
                    && request.resource.data.monthly <= 1000000000;

      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && isValidLeaderboardDoc()
                    // Bajado de 15s a 1s a petición expresa, para uniformar
                    // con el throttle de saves/{uid} (ver ese bloque más
                    // arriba). No hay ninguna escritura de Invasión aquí —
                    // este cambio es solo por consistencia entre colecciones,
                    // no por necesidad del bug de saves/.
                    && request.time > resource.data.updatedAt + duration.value(1, 's')
                    // 'total' es un contador que solo crece con el juego
                    // normal: nunca debe bajar de golpe en el ranking público
                    // (evita "resetear" para limpiar sospechas) ni subir más
                    // de lo que el ritmo de producción más alto del juego
                    // permitiría en el tiempo transcurrido desde la última
                    // escritura aceptada.
                    && request.resource.data.total >= resource.data.total
                    && growthWithinCap('total')
                    // 'weekly'/'monthly' SÍ pueden bajar de golpe (se
                    // resetean al empezar un nuevo periodo, ver
                    // ensurePeriods()/weeklyScore() en el cliente), así que
                    // no se exige que sean crecientes — pero si suben, deben
                    // respetar el mismo ritmo máximo que 'total', porque
                    // ambos se derivan del mismo contador base (totalClk).
                    && (request.resource.data.weekly <= resource.data.weekly || growthWithinCap('weekly'))
                    && (request.resource.data.monthly <= resource.data.monthly || growthWithinCap('monthly'))
                    // El nivel es un contador discreto: no puede bajar, y
                    // como máximo sube de 1 en 1 por evento de "level up" en
                    // el cliente, así que un salto de más de 1 por escritura
                    // (con el throttle de 15s de por medio) es imposible en
                    // juego legítimo.
                    && request.resource.data.lvl >= resource.data.lvl
                    && request.resource.data.lvl <= resource.data.lvl + 1;

      allow delete: if false;

      function isValidLeaderboardDoc() {
        let d = request.resource.data;
        return d.keys().hasOnly(['alias', 'total', 'weekly', 'monthly', 'lvl', 'updatedAt'])
          && d.alias is string
          && d.alias.size() > 0
          && d.alias.size() <= 16
          && d.total is int
          && d.total >= 0
          && d.weekly is int
          && d.weekly >= 0
          && d.monthly is int
          && d.monthly >= 0
          && d.lvl is int
          && d.lvl >= 1
          && d.updatedAt == request.time;
      }

      // Techo de crecimiento de un contador acumulativo entre dos escrituras:
      // 50,000 unidades/segundo de margen (muy por encima de lo alcanzable
      // con las mejoras más caras del juego actual + boosts activos), para
      // no bloquear a jugadores legítimos de alto nivel mientras sí impide
      // el salto instantáneo y arbitrario descrito en el reporte (poner
      // $CLK infinito de un solo setDoc desde la consola).
      function growthWithinCap(field) {
        let elapsedSeconds = (request.time.toMillis() - resource.data.updatedAt.toMillis()) / 1000;
        let maxGrowth = elapsedSeconds * 50000 + 50000;
        return request.resource.data[field] - resource.data[field] <= maxGrowth;
      }
    }

    // ═══════════════════════════════════════════════════════════════
    // MODO INVASIÓN — colecciones invasion_players, invasion_targets,
    // invasion_attacks. Sin estas reglas, cualquier lectura/escritura
    // contra esas colecciones cae en el catch-all de más abajo y se
    // rechaza con PERMISSION_DENIED (esto es lo que causaba que el
    // modo se quedara colgado en la pantalla de carga).
    // ═══════════════════════════════════════════════════════════════
    match /invasion_players/{uid} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && isValidPlayerDoc()
                    && request.resource.data.clk <= 1000000000;

      // Un update puede venir de tres casos:
      //  (a) el propio jugador sincronizando su perfil / activando escudo
      //      / actualizando su propio cooldown tras invadir
      //  (b) el DEFENSOR de un duelo ya resuelto escribiendo el resultado
      //      sobre TU documento cuando TÚ eras el defensor y perdiste
      //      (baja tu clk, sube tu lastAttackedAt)
      //  (c) el DEFENSOR de un duelo ya resuelto escribiendo el resultado
      //      sobre TU documento cuando TÚ eras el atacante y ganaste (sube
      //      tu clk) — resolveDuel()/expirePendingAttack() se ejecutan con
      //      request.auth.uid == defenderUid, así que es el defensor quien
      //      tiene que escribir el alza de clk del atacante, dentro del
      //      mismo batch que baja la suya propia (caso (b)).
      // No se puede distinguir (a) de (b)/(c) por request.auth.uid == uid,
      // así que se acota por CAMPOS TOCADOS + rango de cambio permitido.
      allow update: if request.auth != null && (
                      isSelfProfileUpdate()
                      || isIncomingRobberyUpdate()
                      || isOutgoingRewardUpdate()
                    );

      allow delete: if false;

      function isValidPlayerDoc() {
        let d = request.resource.data;
        return d.keys().hasOnly([
          'alias','lvl','clk','shieldUntil','shieldType','accountCreatedAt',
          'lastAttackedAt','lastInvasionAt','invasionsToday','invasionsDayKey',
          'recentTargets','updatedAt'
        ])
          && d.alias is string && d.alias.size() > 0 && d.alias.size() <= 16
          && d.lvl is int && d.lvl >= 1
          && d.clk is int && d.clk >= 0
          && d.shieldUntil is int && d.shieldUntil >= 0
          && d.shieldType is string
          && d.accountCreatedAt is int && d.accountCreatedAt > 0
          && d.lastAttackedAt is int && d.lastAttackedAt >= 0
          && d.lastInvasionAt is int && d.lastInvasionAt >= 0
          && d.invasionsToday is int && d.invasionsToday >= 0 && d.invasionsToday <= 20
          && d.invasionsDayKey is string
          && d.recentTargets is map
          && d.updatedAt == request.time;
      }

      // El cooldown de más abajo (request.time > before.updatedAt + 300ms)
      // solo se exige CUANDO clk sube — es decir, cuando este update
      // podría ser el "auto-robo fabricado a mano" que describe el
      // comentario de más abajo. Antes se exigía SIEMPRE, para cualquier
      // update del propio dueño, pero syncProfileFromMainSave() se llama
      // en el boot() de las TRES pantallas (index.html, search.html,
      // minigame.html) — un jugador navegando con normalidad de una a
      // otra (pulsar "BUSCAR RIVAL" o "ATACAR" apenas cargó la pantalla
      // anterior) encadena dos de esas sincronizaciones en un margen de
      // tiempo que puede ser menor a cualquier cooldown fijo razonable,
      // y esas sincronizaciones NO suben clk casi nunca (solo cooldowns,
      // alias, nivel) — no hay razón para limitarlas por tiempo. El
      // cooldown solo tiene sentido cuando SÍ sube clk, que es el único
      // caso con superficie de abuso real.
      //
      // El alza de clk (cuando el jugador GANA un robo) no se puede
      // verificar aquí contra el attack doc exacto: Firestore Rules no
      // permite hacer una query dentro de una condición de seguridad,
      // solo get() por path conocido, y el id de invasion_attacks incluye
      // un timestamp que la regla no puede adivinar. Verificación exacta
      // requeriría Cloud Functions.
      //
      // Lo que SÍ se hace aquí, con honestidad sobre lo que cubre y lo
      // que no: un techo absoluto duro por escritura, más un cooldown de
      // 300ms que solo aplica cuando clk sube. No confirma que el alza
      // corresponda a un robo real, pero limita el daño máximo de un
      // intento de auto-robo fabricado a mano a una cifra pequeña frente
      // a los saldos típicos del juego, y el cooldown impide repetir el
      // truco en ráfaga sin penalizar la navegación normal entre
      // pantallas (que nunca sube clk en el mismo golpe).
      function isSelfProfileUpdate() {
        let d = request.resource.data;
        let before = resource.data;
        let clkIncrease = d.clk - before.clk;
        return request.auth.uid == uid
          && isValidPlayerDoc()
          && d.accountCreatedAt == before.accountCreatedAt // inmutable una vez fijado
          && clkIncrease <= 200000000 // techo dado, no verificación exacta — ver comentario arriba
          && (clkIncrease <= 0 || request.time > before.updatedAt + duration.value(300, 'ms'));
      }

      // Caso (b): el DEFENSOR de un duelo ya resuelto escribe el resultado
      // SOBRE TU documento cuando TÚ eras el defensor y perdiste. Solo
      // puede tocar clk/lastAttackedAt/updatedAt, `clk` solo puede BAJAR
      // (nunca a negativo, nunca a 0 en seco: el mínimo lo aplica
      // invasion-core.js con MIN_CLK_LEFT_AFTER_ROB, aquí se exige como
      // cota dura clk >= 0). No necesita cooldown propio: bajar clk no es
      // una superficie de auto-abuso (nadie se beneficia de robarse saldo
      // a sí mismo), y el atacante ya tiene su propio cooldown de
      // invasión (CFG.INVASION_COOLDOWN_MS, aplicado en checkCanInvade()).
      function isIncomingRobberyUpdate() {
        let d = request.resource.data;
        let before = resource.data;
        return request.auth.uid != uid
          && d.diff(before).affectedKeys().hasOnly(['clk','lastAttackedAt','updatedAt'])
          && d.clk is int && d.clk >= 0 && d.clk <= before.clk
          && d.lastAttackedAt is int && d.lastAttackedAt >= before.lastAttackedAt
          && d.updatedAt == request.time;
      }

      // Caso (c): el DEFENSOR de un duelo ya resuelto (request.auth.uid ==
      // defenderUid del ataque, no el uid de este documento) sube el clk
      // del ATACANTE tras perder — este doc es el del atacante (uid ==
      // attackerUid), así que aquí request.auth.uid NUNCA es igual a uid,
      // exactamente igual que en isIncomingRobberyUpdate(); ambos casos son
      // indistinguibles entre sí por esa sola condición (los dos son "otro
      // jugador autenticado toca tu clk"), así que se distinguen por la
      // DIRECCIÓN del cambio: aquí solo se permite que clk SUBA, en
      // isIncomingRobberyUpdate() solo se permite que BAJE — un mismo
      // batch.commit() de resolveDuel()/expirePendingAttack() dispara una
      // escritura de cada tipo, una por cada documento afectado, nunca las
      // dos sobre el mismo doc a la vez.
      //
      // BUGFIX: esta función faltaba en este archivo (el firestore.rules
      // real y desplegado del proyecto padre) aunque ya estaba completa en
      // invasion/firestore/invasion.rules (la copia de preintegración de
      // estas mismas reglas) — nunca se trasladó al copiar el resto del
      // bloque. Sin ella, la escritura que sube el clk del atacante caía
      // en isIncomingRobberyUpdate() (que exige clk <= before.clk) y se
      // rechazaba. Al ser un writeBatch, el rechazo de CUALQUIER operación
      // tumba el batch COMPLETO: ni el atacante cobraba, ni el defensor
      // perdía saldo, ni invasion_attacks pasaba a 'resolved' — el duelo
      // se quedaba 'pending' para siempre pese a que el minijuego de
      // defensa sí se había jugado.
      //
      // Misma honestidad que el resto del archivo: no se puede verificar
      // aquí que exista de verdad un invasion_attacks/{attackId} con
      // status:'pending' que respalde este alza -Rules no puede hacer
      // queries, y el id del ataque no es conocido en esta regla-, así que
      // se acota por un techo absoluto duro, MISMA cifra que el resto de
      // topes de "auto-robo fabricado a mano" del archivo
      // (isSelfProfileUpdate, isTargetClkOnlyUpdate). No impide un update
      // aislado y fabricado a mano por completo, pero limita el daño
      // máximo de uno solo y el cooldown de invasión (aplicado en
      // checkCanInvade() del lado cliente) impide repetirlo en ráfaga
      // desde la misma cuenta atacante.
      function isOutgoingRewardUpdate() {
        let d = request.resource.data;
        let before = resource.data;
        return request.auth.uid != uid
          && d.diff(before).affectedKeys().hasOnly(['clk','updatedAt'])
          && d.clk is int && d.clk >= before.clk && d.clk - before.clk <= 200000000
          && d.updatedAt == request.time;
      }
    }

    // ===== invasion_targets/{uid} =====
    // Espejo mínimo público, solo para la query aleatoria de "buscar
    // rival". Mismo razonamiento de doble caso que invasion_players:
    // el propio dueño lo sincroniza; un atacante puede bajar el `clk`
    // reflejado aquí tras un robo ganado, o subir el suyo propio.
    match /invasion_targets/{uid} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && isValidTargetDoc();

      allow update: if request.auth != null && (
                      (request.auth.uid == uid && isValidTargetDoc())
                      || isTargetClkOnlyUpdate()
                    );

      allow delete: if false;

      function isValidTargetDoc() {
        let d = request.resource.data;
        return d.keys().hasOnly(['alias','lvl','clk','shieldUntil','accountCreatedAt','rand'])
          && d.alias is string && d.alias.size() <= 16
          && d.lvl is int && d.lvl >= 1
          && d.clk is int && d.clk >= 0
          && d.shieldUntil is int && d.shieldUntil >= 0
          && d.accountCreatedAt is int && d.accountCreatedAt > 0
          && d.rand is number && d.rand >= 0 && d.rand <= 1;
      }

      // Tras un robo, invasion-core.js hace un merge que SOLO toca `clk`
      // en este doc espejo — y en DOS sentidos distintos según de quién es
      // el documento: el del defensor BAJA (le robaron), el del atacante
      // SUBE (ganó el botín). Por eso esta regla no puede exigir "solo
      // baja" como si fuera un caso único — no hay forma de que Rules
      // distinga aquí "este doc es del defensor" de "este doc es del
      // atacante" sin otro get(), así que se acepta que clk cambie en
      // cualquier dirección, acotado por un techo absoluto (mismo
      // razonamiento y MISMO número que el techo de auto-robo en
      // invasion_players/isSelfProfileUpdate — debe coincidir siempre,
      // porque un solo robo escribe en ambos documentos, dentro del mismo
      // batch, con idéntico stolenAmount).
      function isTargetClkOnlyUpdate() {
        let d = request.resource.data;
        let before = resource.data;
        return d.diff(before).affectedKeys().hasOnly(['clk'])
          && d.clk is int && d.clk >= 0
          && (d.clk <= before.clk || d.clk - before.clk <= 200000000);
      }
    }

    // ===== invasion_attacks/{attackId} =====
    // Flujo de dos fases (ver docs/DISEÑO.md sección 3): se crea en
    // estado 'pending' cuando el atacante lanza el misil (fase 1, solo
    // conoce attackScore) y pasa a 'resolved' cuando el defensor
    // completa su minijuego de interceptación (fase 2, añade
    // defenseScore/won/stolenAmount reales). Esta es la versión
    // sincronizada con invasion/firestore/invasion.rules — antes este
    // archivo tenía todavía la regla del diseño ANTIGUO de una sola fase
    // (sin 'pending'/'attackScore'/'defenseScore' en el esquema
    // permitido y con allow update: if false), lo que rechazaba tanto
    // createPendingAttack() como resolveDuel() con
    // "Missing or insufficient permissions" pese a que el código ya
    // llevaba tiempo escribiendo el esquema nuevo.
    //
    // Existe una TERCERA transición además de crear/resolver-jugado: la
    // expiración por incomparecencia (a petición expresa) — si pasan 24h
    // sin que el defensor responda, el duelo se resuelve solo a favor
    // del atacante, con el mismo botín que una victoria jugada. Ver
    // isValidExpiryResolution() más abajo y expirePendingAttack() en
    // invasion-core.js.
    match /invasion_attacks/{attackId} {
      allow read: if request.auth != null;

      // Fase 1: solo el ATACANTE puede crear un ataque (a diferencia del
      // diseño de una sola fase, el defensor no interviene hasta la
      // fase 2, así que no tiene sentido -ni sería seguro- dejarle crear
      // el documento).
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.attackerUid
                    && isValidPendingAttackDoc();

      // Fase 2: dos transiciones posibles de pending -> resolved, con
      // requisitos de "quién" distintos cada una:
      //  (a) jugó su minijuego de defensa -> isValidDuelResolution(),
      //      SOLO el DEFENSOR — introduce un defenseScore que nadie más
      //      debería poder inventar en su nombre, así que aquí sí importa
      //      de verdad quién ejecuta la escritura.
      //  (b) no respondió en 24h -> isValidExpiryResolution(), CUALQUIER
      //      usuario autenticado — esta transición no depende de ningún
      //      dato que aporte quien la ejecuta (won/stolenAmount/
      //      defenseScore están completamente fijados por la propia
      //      regla a partir de before, no del request), así que un
      //      tercero ejecutándola produce exactamente el mismo resultado
      //      que si la ejecutara el defensor — el propio comentario de
      //      isValidExpiryResolution() ya lo explicaba: la salvaguarda
      //      real es el TIEMPO (request.time del servidor contra
      //      before.createdAt), no el ejecutor.
      //
      // BUGFIX: antes, ambas ramas exigían request.auth.uid ==
      // defenderUid en el propio allow update, así que SOLO el defensor
      // podía disparar (b) — pero getPendingAttacksFor() en
      // invasion-core.js, la única función que llama a esto en la
      // práctica, siempre se invoca con el uid del jugador conectado en
      // ese momento, nunca con un uid ajeno (no hay backend con reloj:
      // ver cabecera del archivo, todo se dispara desde el cliente al
      // entrar a una pantalla). Resultado: si el defensor no volvía a
      // abrir el juego, su pendiente vencido nunca se expiraba —
      // seguía en status:'pending' indefinidamente, y con él, cualquier
      // filtro que mirara ese estado (por ejemplo, no aparecer en
      // búsqueda mientras hay defensa pendiente) se quedaba bloqueado
      // más allá de las 24h reales. Separar (b) para que cualquiera
      // pueda dispararla (p.ej. un atacante que se cruza con ese
      // defensor al buscar rival) es lo que permite que
      // hasActivePendingDefense()/firstValidCandidate() en
      // invasion-core.js puedan, además de TRATAR como libre a un
      // candidato con pendiente vencido, dejarlo REALMENTE resuelto de
      // una vez sin esperar a que su dueño vuelva.
      allow update: if request.auth != null && (
                      (request.auth.uid == resource.data.defenderUid && isValidDuelResolution())
                      || isValidExpiryResolution()
                    );

      allow delete: if false;

      function isValidPendingAttackDoc() {
        let d = request.resource.data;
        return d.keys().hasOnly([
          'attackerUid','attackerAlias','defenderUid','defenderAlias',
          'attackerLvl','defenderLvl','difficulty',
          'attackScore','defenseScore','status',
          'won','stolenAmount','isRevenge','createdAt'
        ])
          && d.attackerUid is string && d.attackerUid.size() > 0
          && d.defenderUid is string && d.defenderUid.size() > 0
          && d.attackerUid != d.defenderUid
          && d.attackerAlias is string && d.attackerAlias.size() <= 16
          && d.defenderAlias is string && d.defenderAlias.size() <= 16
          && d.attackerLvl is int && d.attackerLvl >= 1
          && d.defenderLvl is int && d.defenderLvl >= 1
          && d.difficulty in ['muy_facil','facil','normal','dificil','muy_dificil']
          && d.attackScore is int && d.attackScore >= 0 && d.attackScore <= 100
          && d.defenseScore == null
          && d.status == 'pending'
          && d.won == false            // placeholder obligatorio mientras está pendiente
          && d.stolenAmount == 0       // placeholder obligatorio mientras está pendiente
          && d.isRevenge is bool
          && d.createdAt == request.time;
      }

      // Recalcular aquí el stolenAmount exacto a partir de tier.robMax
      // requeriría leer invasion_players/{defenderUid}.clk dentro de la
      // regla (Rules SÍ permite un get() por path conocido, a diferencia
      // de una query) — se opta por NO hacerlo para no encadenar una
      // lectura adicional a cada escritura de duelo, y en su lugar se
      // acota por el mismo techo absoluto duro que ya usa el resto del
      // archivo (ver isTargetClkOnlyUpdate más arriba) más la coherencia
      // interna won<->stolenAmount, que si son consistentes entre sí es
      // la parte con más superficie de abuso real.
      function isValidDuelResolution() {
        let d = request.resource.data;
        let before = resource.data;
        return before.status == 'pending'
          && d.diff(before).affectedKeys().hasOnly(['defenseScore','status','won','stolenAmount','resolvedAt'])
          && d.defenseScore is int && d.defenseScore >= 0 && d.defenseScore <= 100
          && d.status == 'resolved'
          && d.won is bool
          && d.stolenAmount is int && d.stolenAmount >= 0 && d.stolenAmount <= 200000000
          && (d.won == false ? d.stolenAmount == 0 : true) // perder (el atacante) nunca roba nada
          && d.resolvedAt == request.time;
      }

      // Expiración por incomparecencia: mismo shape de campos tocados
      // que isValidDuelResolution() (defenseScore/status/won/
      // stolenAmount/resolvedAt), MÁS expiredByTimeout, que distingue
      // esta resolución de una jugada de verdad en el historial. La
      // salvaguarda real no es de quién ejecuta esto (ya lo exige el
      // allow update de arriba) sino de TIEMPO: request.time es el reloj
      // del servidor de Firestore, no algo que el cliente pueda adelantar
      // — así que aunque alguien edite este código en DevTools para
      // llamar a expirePendingAttack() antes de tiempo, la regla lo
      // rechaza igual si no han pasado de verdad las 24h reales desde
      // before.createdAt. won siempre true aquí (incomparecencia =
      // victoria del atacante, a petición expresa: "se marca como una
      // victoria más para el atacante y recibe el botín... que además
      // se le debe restar al atacado siempre que pierda").
      function isValidExpiryResolution() {
        let d = request.resource.data;
        let before = resource.data;
        return before.status == 'pending'
          && request.time > before.createdAt + duration.value(24, 'h')
          && d.diff(before).affectedKeys().hasOnly(['defenseScore','status','won','stolenAmount','resolvedAt','expiredByTimeout'])
          && d.defenseScore == 0        // el defensor nunca llegó a jugar, no es un 0 "jugado"
          && d.status == 'resolved'
          && d.won == true              // incomparecencia siempre resuelve a favor del atacante
          && d.stolenAmount is int && d.stolenAmount >= 0 && d.stolenAmount <= 200000000
          && d.expiredByTimeout == true
          && d.resolvedAt == request.time;
      }
    }

    // Todo lo demás, denegado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
