rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== saves/{uid} =====
    // Guardado autoritativo del progreso del jugador. El cliente escribe
    // {data: JSON.stringify(estado), updatedAt: serverTimestamp()}.
    // Firestore Rules NO puede parsear el JSON de 'data' campo a campo, así
    // que la validación de contenido real (saldo, nivel, mejoras) no se
    // puede hacer aquí de forma completa: eso requiere mover el guardado
    // autoritativo a una Cloud Function que recalcule el estado en servidor
    // en vez de aceptar el JSON íntegro que manda el cliente (recomendado).
    //
    // Mientras tanto, estas reglas SÍ cierran el hueco de "escribir lo que
    // sea, cuando sea": validan esquema/tipos, ponen un tamaño máximo
    // razonable a 'data' (evita inflar el documento con basura), exigen que
    // 'updatedAt' sea el timestamp real del servidor (no se puede falsificar
    // la fecha desde el cliente) y fuerzan el mismo throttle mínimo que ya
    // usa la app (CLOUD_MIN_INTERVAL = 20s) también del lado servidor, para
    // que llamar a window.forceSaveCloud() en bucle desde la consola no
    // sirva para machacar el documento en ráfaga.
    match /saves/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && isValidSaveDoc();

      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && isValidSaveDoc()
                    // Mínimo 15s desde la última escritura aceptada (algo por
                    // debajo del throttle de 20s del cliente, para no rechazar
                    // por pequeños desfases de reloj/red legítimos).
                    && request.time > resource.data.updatedAt + duration.value(15, 's');

      allow delete: if false;

      function isValidSaveDoc() {
        let d = request.resource.data;
        return d.keys().hasOnly(['data', 'updatedAt'])
          && d.data is string
          && d.data.size() > 0
          && d.data.size() <= 20000
          && d.updatedAt == request.time;
      }
    }

    // ===== leaderboard/{uid} =====
    // Versión pública y mínima del progreso de cada jugador (alias + puntajes).
    // Cualquier usuario autenticado puede LEER toda la colección para armar
    // el ranking global; cada quien solo puede escribir su propio documento.
    //
    // A diferencia de saves/, aquí los campos SÍ están planos y tipados, así
    // que se puede validar esquema, tipos y rango en serio: esto es lo que
    // impide que alguien use window.__fb / setDoc directo desde la consola
    // para falsear su posición en el Top 100 sin jugar.
    match /leaderboard/{uid} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && isValidLeaderboardDoc()
                    // En un documento nuevo no hay progreso previo que
                    // validar por delta: solo se acota a un techo absoluto
                    // muy generoso, para que ni siquiera el primer publish
                    // pueda arrancar con un valor de "saldo infinito"
                    // instantáneo. No se acota 'lvl' aquí porque el juego no
                    // define un nivel máximo (incremental sin techo).
                    && request.resource.data.total <= 1000000000
                    && request.resource.data.weekly <= 1000000000
                    && request.resource.data.monthly <= 1000000000;

      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && isValidLeaderboardDoc()
                    // Throttle igual que saves/: no se puede reescribir en ráfaga.
                    && request.time > resource.data.updatedAt + duration.value(15, 's')
                    // 'total' es un contador que solo crece con el juego
                    // normal: nunca debe bajar de golpe en el ranking público
                    // (evita "resetear" para limpiar sospechas) ni subir más
                    // de lo que el ritmo de producción más alto del juego
                    // permitiría en el tiempo transcurrido desde la última
                    // escritura aceptada.
                    && request.resource.data.total >= resource.data.total
                    && growthWithinCap('total')
                    // 'weekly'/'monthly' SÍ pueden bajar de golpe (se
                    // resetean al empezar un nuevo periodo, ver
                    // ensurePeriods()/weeklyScore() en el cliente), así que
                    // no se exige que sean crecientes — pero si suben, deben
                    // respetar el mismo ritmo máximo que 'total', porque
                    // ambos se derivan del mismo contador base (totalClk).
                    && (request.resource.data.weekly <= resource.data.weekly || growthWithinCap('weekly'))
                    && (request.resource.data.monthly <= resource.data.monthly || growthWithinCap('monthly'))
                    // El nivel es un contador discreto: no puede bajar, y
                    // como máximo sube de 1 en 1 por evento de "level up" en
                    // el cliente, así que un salto de más de 1 por escritura
                    // (con el throttle de 15s de por medio) es imposible en
                    // juego legítimo.
                    && request.resource.data.lvl >= resource.data.lvl
                    && request.resource.data.lvl <= resource.data.lvl + 1;

      allow delete: if false;

      function isValidLeaderboardDoc() {
        let d = request.resource.data;
        return d.keys().hasOnly(['alias', 'total', 'weekly', 'monthly', 'lvl', 'updatedAt'])
          && d.alias is string
          && d.alias.size() > 0
          && d.alias.size() <= 16
          && d.total is int
          && d.total >= 0
          && d.weekly is int
          && d.weekly >= 0
          && d.monthly is int
          && d.monthly >= 0
          && d.lvl is int
          && d.lvl >= 1
          && d.updatedAt == request.time;
      }

      // Techo de crecimiento de un contador acumulativo entre dos escrituras:
      // 50,000 unidades/segundo de margen (muy por encima de lo alcanzable
      // con las mejoras más caras del juego actual + boosts activos), para
      // no bloquear a jugadores legítimos de alto nivel mientras sí impide
      // el salto instantáneo y arbitrario descrito en el reporte (poner
      // $CLK infinito de un solo setDoc desde la consola).
      function growthWithinCap(field) {
        let elapsedSeconds = (request.time.toMillis() - resource.data.updatedAt.toMillis()) / 1000;
        let maxGrowth = elapsedSeconds * 50000 + 50000;
        return request.resource.data[field] - resource.data[field] <= maxGrowth;
      }
    }

    // ═══════════════════════════════════════════════════════════════
    // MODO INVASIÓN — colecciones invasion_players, invasion_targets,
    // invasion_attacks. Sin estas reglas, cualquier lectura/escritura
    // contra esas colecciones cae en el catch-all de más abajo y se
    // rechaza con PERMISSION_DENIED (esto es lo que causaba que el
    // modo se quedara colgado en la pantalla de carga).
    // ═══════════════════════════════════════════════════════════════
    match /invasion_players/{uid} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && isValidPlayerDoc()
                    && request.resource.data.clk <= 1000000000;

      // Un update puede venir de dos casos:
      //  (a) el propio jugador sincronizando su perfil / activando escudo
      //      / actualizando su propio cooldown tras invadir
      //  (b) otro jugador autenticado escribiendo el resultado de un robo
      //      sobre TU documento (baja tu clk, sube tu lastAttackedAt)
      // No se puede distinguir (a) de (b) por request.auth.uid == uid,
      // así que se acota por CAMPOS TOCADOS + rango de cambio permitido.
      allow update: if request.auth != null && (
                      isSelfProfileUpdate()
                      || isIncomingRobberyUpdate()
                    );

      allow delete: if false;

      function isValidPlayerDoc() {
        let d = request.resource.data;
        return d.keys().hasOnly([
          'alias','lvl','clk','shieldUntil','shieldType','accountCreatedAt',
          'lastAttackedAt','lastInvasionAt','invasionsToday','invasionsDayKey',
          'recentTargets','updatedAt'
        ])
          && d.alias is string && d.alias.size() > 0 && d.alias.size() <= 16
          && d.lvl is int && d.lvl >= 1
          && d.clk is int && d.clk >= 0
          && d.shieldUntil is int && d.shieldUntil >= 0
          && d.shieldType is string
          && d.accountCreatedAt is int && d.accountCreatedAt > 0
          && d.lastAttackedAt is int && d.lastAttackedAt >= 0
          && d.lastInvasionAt is int && d.lastInvasionAt >= 0
          && d.invasionsToday is int && d.invasionsToday >= 0 && d.invasionsToday <= 20
          && d.invasionsDayKey is string
          && d.recentTargets is map
          && d.updatedAt == request.time;
      }

      // El cooldown de 1s de más abajo (request.time > before.updatedAt +
      // 1s) depende implícitamente de que el flujo de la app SIEMPRE deje
      // pasar más de 1s entre sincronizar el perfil (syncProfileFromMainSave,
      // llamado en boot() de minigame.html) y resolver la invasión
      // (resolveInvasion, llamado al terminar el minijuego). Eso se cumple
      // hoy con margen de sobra: el countdown de 3-2-1 antes de empezar ya
      // son ~2.1s, y el minijuego dura 10-20s más. Si en el futuro se
      // acorta el countdown o se permite saltarlo, revisar que este
      // margen siga cumpliéndose — si no, un jugador legítimo que gane
      // instantáneamente podría ver su propio resolveInvasion rechazado
      // por Rules sin haber hecho nada indebido.
      //
      // El alza de clk (cuando el jugador GANA un robo) no se puede
      // verificar aquí contra el attack doc exacto: Firestore Rules no
      // permite hacer una query dentro de una condición de seguridad,
      // solo get() por path conocido, y el id de invasion_attacks incluye
      // un timestamp que la regla no puede adivinar. Verificación exacta
      // requeriría Cloud Functions.
      //
      // Lo que SÍ se hace aquí, con honestidad sobre lo que cubre y lo
      // que no: un techo absoluto duro por escritura. No confirma que el
      // alza corresponda a un robo real, pero limita el daño máximo de
      // un intento de auto-robo fabricado a mano a una cifra pequeña
      // frente a los saldos típicos del juego, y el cooldown de 1s de
      // más abajo impide repetir el truco en ráfaga.
      function isSelfProfileUpdate() {
        let d = request.resource.data;
        let before = resource.data;
        let clkIncrease = d.clk - before.clk;
        return request.auth.uid == uid
          && isValidPlayerDoc()
          && d.accountCreatedAt == before.accountCreatedAt // inmutable una vez fijado
          && request.time > before.updatedAt + duration.value(1, 's') // evita ráfaga
          && clkIncrease <= 9000; // techo dado, no verificación exacta — ver comentario arriba
      }

      // Caso (b): otro jugador (el atacante) escribe el resultado de un
      // robo SOBRE TU documento. Solo puede tocar clk/lastAttackedAt/
      // updatedAt, `clk` solo puede BAJAR (nunca a negativo, nunca a 0
      // en seco: el mínimo lo aplica invasion-core.js con
      // MIN_CLK_LEFT_AFTER_ROB, aquí se exige como cota dura clk >= 0),
      // y con el mismo techo de cooldown de 1s para evitar ráfaga.
      function isIncomingRobberyUpdate() {
        let d = request.resource.data;
        let before = resource.data;
        return request.auth.uid != uid
          && d.diff(before).affectedKeys().hasOnly(['clk','lastAttackedAt','updatedAt'])
          && d.clk is int && d.clk >= 0 && d.clk <= before.clk
          && d.lastAttackedAt is int && d.lastAttackedAt >= before.lastAttackedAt
          && d.updatedAt == request.time;
      }
    }

    // ===== invasion_targets/{uid} =====
    // Espejo mínimo público, solo para la query aleatoria de "buscar
    // rival". Mismo razonamiento de doble caso que invasion_players:
    // el propio dueño lo sincroniza; un atacante puede bajar el `clk`
    // reflejado aquí tras un robo ganado, o subir el suyo propio.
    match /invasion_targets/{uid} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && isValidTargetDoc();

      allow update: if request.auth != null && (
                      (request.auth.uid == uid && isValidTargetDoc())
                      || isTargetClkOnlyUpdate()
                    );

      allow delete: if false;

      function isValidTargetDoc() {
        let d = request.resource.data;
        return d.keys().hasOnly(['alias','lvl','clk','shieldUntil','accountCreatedAt','rand'])
          && d.alias is string && d.alias.size() <= 16
          && d.lvl is int && d.lvl >= 1
          && d.clk is int && d.clk >= 0
          && d.shieldUntil is int && d.shieldUntil >= 0
          && d.accountCreatedAt is int && d.accountCreatedAt > 0
          && d.rand is number && d.rand >= 0 && d.rand <= 1;
      }

      // Tras un robo, invasion-core.js hace un merge que SOLO toca `clk`
      // en este doc espejo — y en DOS sentidos distintos según de quién es
      // el documento: el del defensor BAJA (le robaron), el del atacante
      // SUBE (ganó el botín). Por eso esta regla no puede exigir "solo
      // baja" como si fuera un caso único — no hay forma de que Rules
      // distinga aquí "este doc es del defensor" de "este doc es del
      // atacante" sin otro get(), así que se acepta que clk cambie en
      // cualquier dirección, acotado por un techo absoluto (mismo
      // razonamiento y mismo número que el techo de auto-robo en
      // invasion_players/isSelfProfileUpdate).
      function isTargetClkOnlyUpdate() {
        let d = request.resource.data;
        let before = resource.data;
        return d.diff(before).affectedKeys().hasOnly(['clk'])
          && d.clk is int && d.clk >= 0
          && (d.clk <= before.clk || d.clk - before.clk <= 9000);
      }
    }

    // ===== invasion_attacks/{attackId} =====
    // Historial de robos. Se crea una vez por invasión resuelta, nunca
    // se actualiza ni se borra. El atacante autenticado es quien escribe
    // (es quien resuelve el batch completo), así que no se exige que
    // request.auth.uid coincida con attackerUid como único caso — se
    // exige que SEA uno de los dos participantes reales según lo que el
    // propio documento declara, y que la forma/rango sea válida.
    match /invasion_attacks/{attackId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && (request.auth.uid == request.resource.data.attackerUid
                        || request.auth.uid == request.resource.data.defenderUid)
                    && isValidAttackDoc();

      allow update: if false;
      allow delete: if false;

      function isValidAttackDoc() {
        let d = request.resource.data;
        return d.keys().hasOnly([
          'attackerUid','attackerAlias','defenderUid','defenderAlias',
          'attackerLvl','defenderLvl','difficulty','won','stolenAmount',
          'isRevenge','createdAt'
        ])
          && d.attackerUid is string && d.attackerUid.size() > 0
          && d.defenderUid is string && d.defenderUid.size() > 0
          && d.attackerUid != d.defenderUid
          && d.attackerAlias is string && d.attackerAlias.size() <= 16
          && d.defenderAlias is string && d.defenderAlias.size() <= 16
          && d.attackerLvl is int && d.attackerLvl >= 1
          && d.defenderLvl is int && d.defenderLvl >= 1
          && d.difficulty in ['muy_facil','facil','normal','dificil','muy_dificil']
          && d.won is bool
          && d.stolenAmount is int && d.stolenAmount >= 0
          && (d.won == false ? d.stolenAmount == 0 : true) // perder nunca roba nada
          && d.isRevenge is bool
          && d.createdAt == request.time;
      }
    }

    // Todo lo demás, denegado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
